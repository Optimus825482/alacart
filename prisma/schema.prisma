generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN     // Sistem Yöneticisi (Tüm sistem tanımları, kullanıcılar, genel ayarlar)
  CHEF      // Şef Modülü (Tüm alakartlar arası geçiş, master KDS, tarih filtreli PDF/Excel raporlar, audit)
  KITCHEN   // Mutfak Modülü (Sadece görevli olduğu alakartın KDS ekranı ve adisyon yazıcısı)
  WAITER    // Garson Modülü (Görevli olduğu alakartın mobil sipariş terminali ve masa yönetimi)
}

enum TableStatus {
  EMPTY
  OCCUPIED
}

enum OrderStatus {
  PENDING      // Mutfakta bekliyor / Yeni sipariş
  PREPARING    // Mutfakta hazırlanıyor (ocakta)
  COMPLETED    // Mutfakta tamamlandı (servise hazır)
  CANCELLED    // İptal edildi
}

model User {
  id           String             @id @default(uuid())
  name         String             // Ad Soyad
  username     String             @unique // Giriş Kullanıcı Adı
  password     String             @default("1234") // Şifre (Giriş için)
  pin          String?            // Hızlı PIN kodu (isteğe bağlı)
  role         Role               @default(WAITER)
  active       Boolean            @default(true)
  orders       Order[]
  assignedTo   RestaurantUser[]
  auditLogs    AuditLog[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Restaurant {
  id           String             @id @default(uuid())
  name         String             // örn: "The Roof Garden", "The Steak House", "Blue Sea", "Mandarin", "Bella Merit"
  code         String             @unique // örn: "ROOF_GARDEN", "STEAK_HOUSE", "BLUE_SEA", "MANDARIN", "BELLA_MERIT"
  description  String?
  themeKey     String             @default("DEFAULT") // Özel renk ve stil teması anahtarı
  primaryColor String             @default("#eab308") // Ana tema rengi
  accentColor  String             @default("#ca8a04") // İkincil renk
  coverImage   String?            // Restoran kapak görseli
  active       Boolean            @default(true)
  
  tables       RestaurantTable[]
  categories   Category[]
  orders       Order[]
  users        RestaurantUser[]
  auditLogs    AuditLog[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model RestaurantUser {
  id           String      @id @default(uuid())
  userId       String
  restaurantId String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([userId, restaurantId])
}

model RestaurantTable {
  id           String       @id @default(uuid())
  name         String       // örn: "Masa 1", "Teras 04", "VIP Panoramik"
  capacity     Int          @default(4)
  status       TableStatus  @default(EMPTY)
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Category {
  id           String       @id @default(uuid())
  name         String       // örn: "Yiyecekler", "İçecekler", "Başlangıçlar", "Soğuk Başlangıçlar"
  description  String?
  displayOrder Int          @default(0)
  active       Boolean      @default(true)
  
  // Hiyerarşik Kategori Ağacı (Self-relation)
  parentId     String?
  parent       Category?    @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]   @relation("SubCategories")

  // Belirli bir alakarta özel menü veya null (tüm alakartlar)
  restaurantId String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  items        MenuItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model MenuItem {
  id           String       @id @default(uuid())
  name         String       // örn: "Wagyu Ribeye", "Pekin Ördeği", "Burrata", "Levrek Buğulama"
  description  String?      // Özellikler, pişme bilgisi, garnitür detayı
  allergens    String?      // Alerjen uyarıları
  imageUrl     String?      // Yiyecek/İçecek fotoğrafı URL veya base64
  active       Boolean      @default(true)
  displayOrder Int          @default(0)

  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  orderItems   OrderItem[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Order {
  id                 String            @id @default(uuid())
  orderNumber        Int               @default(autoincrement())
  status             OrderStatus       @default(PENDING)
  notes              String?           // Masaya özel genel not
  
  restaurantId       String
  restaurant         Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  
  tableId            String
  table              RestaurantTable   @relation(fields: [tableId], references: [id], onDelete: Cascade)

  waiterId           String
  waiter             User              @relation(fields: [waiterId], references: [id], onDelete: Cascade)

  items              OrderItem[]
  
  // Detaylı Zaman Damgaları (Zaman/Süre Raporları ve Audit için)
  preparingStartedAt DateTime?         // Mutfakta "Hazırlanıyor" dendiği an
  printedAt          DateTime?         // Termal fiş basılma anı
  completedAt        DateTime?         // Mutfakta "Tamamlandı" dendiği an
  createdAt          DateTime          @default(now()) // Garsonun siparişi mutfağa fırlattığı an
  updatedAt          DateTime          @updatedAt
}

model OrderItem {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  menuItemId  String
  menuItem    MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  quantity    Int         @default(1)
  itemNotes   String?     // örn: "Az pişmiş", "Buzsuz", "Glutensiz"
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
}

// ==========================================
// AUDIT LOG (DENETİM İZİ TAKİP SİSTEMİ)
// ==========================================
model AuditLog {
  id           String      @id @default(uuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String      // İşlemi yapan kullanıcının adı
  userRole     String      // İşlemi yapanın rolü (ADMIN, CHEF, KITCHEN, WAITER)
  
  action       String      // Örn: "LOGIN", "LOGOUT", "ORDER_CREATED", "STATUS_PREPARING", "STATUS_COMPLETED", "ORDER_PRINTED", "MENU_CREATED"
  entity       String      // Örn: "Order", "User", "MenuItem", "Table", "Restaurant"
  entityId     String?     // İlgili kaydın ID'si
  details      String?     // İşlem detayları (Örn: "Masa 1 için 3 kalem sipariş oluşturuldu")
  
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  createdAt    DateTime    @default(now())
}
